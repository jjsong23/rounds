# Postgres connection string (e.g. from Neon). Include ?sslmode=require.
DATABASE_URL=""

# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Email (Resend). Leave RESEND_API_KEY unset locally — magic links are
# logged to the console instead of sent.
EMAIL_FROM="Rounds <onboarding@rounds.app>"
RESEND_API_KEY=""

# Bearer token required by /api/cron/sweep-dormant-groups
CRON_SECRET=""
